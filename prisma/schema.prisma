datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. USER DATA DOMAIN
// ----------------------------------------------------

enum UserRole {
  USER
  CREATOR
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  role          UserRole          @default(USER)
  accountStatus String            @default("ACTIVE") @map("account_status") // ACTIVE, SUSPENDED, DELETED
  analyticsOptOut Boolean         @default(false) @map("analytics_opt_out")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  accounts      Account[]
  sessions      Session[]
  portfolios    Portfolio[]
  subscription  Subscription?
  resumeUploads ResumeUpload[]
  drafts        PortfolioDraft[]
  aiJobs        AIJob[]
  aiUsages      AIUsage[]
  integrations  Integration[]
  payments      Payment[]
  invoices      Invoice[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ----------------------------------------------------
// 2. RESUME INGESTION & EXTRACTION DOMAIN (TASK 02)
// ----------------------------------------------------

enum UploadStatus {
  PENDING
  PROCESSING
  EXTRACTED
  FAILED
}

model ResumeUpload {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  fileName    String            @map("file_name")
  fileKey     String            @map("file_key") // Private server storage path/key
  mimeType    String            @map("mime_type")
  fileSize    Int               @map("file_size")
  status      UploadStatus      @default(PENDING)
  rawText     String?           @db.Text @map("raw_text")
  errorMessage String?          @map("error_message")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction  ResumeExtraction?

  @@index([userId])
  @@map("resume_uploads")
}

model ResumeExtraction {
  id             String       @id @default(cuid())
  resumeUploadId String       @unique @map("resume_upload_id")
  profile        Json         // Extracted profile header fields
  experience     Json         @default("[]") // Extracted experiences
  education      Json         @default("[]") // Extracted education
  skills         Json         @default("[]") // Extracted skills list/categories
  projects       Json         @default("[]") // Extracted projects
  rawData        Json         @map("raw_data") // Raw parsed sections & tokens
  createdAt      DateTime     @default(now())

  upload         ResumeUpload @relation(fields: [resumeUploadId], references: [id], onDelete: Cascade)

  @@map("resume_extractions")
}

// ----------------------------------------------------
// 3. ONBOARDING & DRAFT SYSTEM (TASK 02)
// ----------------------------------------------------

model PortfolioDraft {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  currentStep       String               @default("profile") @map("current_step")
  profileData       Json                 @map("profile_data")       // Manual form entries
  extractedData     Json?                @map("extracted_data")     // Last parsed resume data
  canonicalProfile  Json?                @map("canonical_profile")  // Approved unified profile
  preferences       Json?                // Target audience, goal, visual intensity
  stylePrompt       String?              @db.Text @map("style_prompt")
  selectedSections  Json?                @map("selected_sections")  // Array of enabled section names
  completenessScore Int                  @default(0) @map("completeness_score")
  completenessData  Json?                @map("completeness_data")  // Missing fields, recommendations
  followUpQuestions Json?                @map("follow_up_questions") // Array of { id, question, answer }
  generatedContent  Json?                @map("generated_content")  // Generated Portfolio Content draft
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conflicts         DataConflictRecord[]

  @@index([userId])
  @@index([updatedAt])
  @@map("portfolio_drafts")
}

model DataConflictRecord {
  id            String         @id @default(cuid())
  draftId       String         @map("draft_id")
  field         String
  values        Json           // Array of { source: DataSource, value: unknown }
  resolved      Boolean        @default(false)
  resolvedValue Json?          @map("resolved_value")
  resolvedAt    DateTime?      @map("resolved_at")
  createdAt     DateTime       @default(now())

  draft         PortfolioDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("data_conflict_records")
}

// ----------------------------------------------------
// 4. ASYNCHRONOUS AI JOBS (TASK 02)
// ----------------------------------------------------

enum AIJobType {
  RESUME_EXTRACT
  PROFILE_NORMALIZE
  COMPLETENESS_ANALYZE
  CONTENT_GENERATE
  SECTION_REGENERATE
  PATCH_APPLY
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model AIJob {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  portfolioId String?     @map("portfolio_id")
  type        AIJobType
  status      AIJobStatus @default(PENDING)
  progress    Int         @default(0) // 0 - 100
  input       Json
  output      Json?
  error       String?
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([portfolioId])
  @@index([createdAt])
  @@map("ai_jobs")
}

model AIUsage {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  portfolioId   String?   @map("portfolio_id")
  jobId         String?   @map("job_id")
  provider      String    @default("openai")
  model         String
  task          String
  inputTokens   Int       @map("input_tokens")
  outputTokens  Int       @map("output_tokens")
  estimatedCost Float     @default(0.0) @map("estimated_cost")
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usages")
}

// ----------------------------------------------------
// 5. PORTFOLIO & ARCHITECTURAL DOMAINS (FROM TASK 01)
// ----------------------------------------------------

model Portfolio {
  id           String            @id @default(cuid())
  userId       String            @map("user_id")
  slug         String            @unique
  title        String
  description  String?           @db.Text
  isPublished  Boolean           @default(false)
  customDomain String?           @unique @map("custom_domain")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      PortfolioContent?
  design       PortfolioDesign?
  scene        PortfolioScene?
  deployments  Deployment[]
  published    PublishedPortfolio?
  domains      Domain[]
  analyticsEvents AnalyticsEvent[]
  visits       PortfolioVisit[]

  @@index([userId])
  @@index([slug])
  @@index([isPublished])
  @@index([customDomain])
  @@map("portfolios")
}

model PortfolioContent {
  id              String    @id @default(cuid())
  portfolioId     String    @unique @map("portfolio_id")
  profileHeader   Json      @map("profile_header")
  socials         Json      @default("[]")
  experiences     Json      @default("[]")
  projects        Json      @default("[]")
  skillCategories Json      @default("[]") @map("skill_categories")
  education       Json      @default("[]")
  customSections  Json      @default("[]") @map("custom_sections")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_contents")
}

model PortfolioDesign {
  id            String    @id @default(cuid())
  portfolioId   String    @unique @map("portfolio_id")
  themeId       String    @default("theme-neon-cyber") @map("theme_id")
  themeName     String    @default("Neon Cyberpunk") @map("theme_name")
  variant       String    @default("dark")
  colors        Json
  typography    Json
  glassmorphism Json
  animations    Json
  layout        Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_designs")
}

model PortfolioScene {
  id             String    @id @default(cuid())
  portfolioId    String    @unique @map("portfolio_id")
  sceneId        String    @default("scene-cyber-dimension") @map("scene_id")
  sceneName      String    @default("Cyber Dimension") @map("scene_name")
  version        String    @default("1.0.0")
  cameraConfig   Json      @map("camera_config")
  lightingConfig Json      @map("lighting_config")
  envConfig      Json      @map("env_config")
  postProcessing Json      @map("post_processing")
  nodes          Json      @default("[]")
  interactivity  Json
  quality        String    @default("high")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_scenes")
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYED
  FAILED
  REMOVED
}

model Deployment {
  id            String           @id @default(cuid())
  portfolioId   String           @map("portfolio_id")
  versionNumber Int              @default(1) @map("version_number")
  versionId     String?          @map("version_id")
  status        DeploymentStatus @default(QUEUED)
  provider      String           @default("edge_cdn")
  domain        String?
  deploymentUrl String?          @map("deployment_url")
  snapshot      Json
  logs          Json?
  errorMsg      String?          @map("error_msg")
  startedAt     DateTime         @default(now()) @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  deployedAt    DateTime?        @map("deployed_at")
  createdAt     DateTime         @default(now())

  portfolio     Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([status])
  @@index([deployedAt])
  @@map("deployments")
}

model PublishedPortfolio {
  id            String    @id @default(cuid())
  portfolioId   String    @unique @map("portfolio_id")
  versionNumber Int       @default(1) @map("version_number")
  versionId     String    @map("version_id")
  slug          String    @unique
  status        String    @default("published") // published, unpublished
  deploymentUrl String    @map("deployment_url")
  snapshot      Json      // Immutable deep snapshot of PortfolioData
  publishedAt   DateTime  @default(now()) @map("published_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@map("published_portfolios")
}

model Domain {
  id                String    @id @default(cuid())
  portfolioId       String    @map("portfolio_id")
  hostname          String    @unique
  type              String    @default("subdomain") // apex, subdomain
  status            String    @default("pending")   // pending, verified, failed
  verificationToken String    @map("verification_token")
  sslStatus         String    @default("pending")   // pending, active, failed
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  portfolio         Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([hostname])
  @@map("domains")
}

enum SubscriptionTier {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
  EXPIRED
}

model Plan {
  id              String                @id @default(cuid())
  code            String                @unique // STARTER, PRO, AGENCY
  name            String
  description     String?
  priceInr        Int                   // Smallest unit (e.g. 50000 = ₹500)
  priceUsd        Int                   // Smallest unit (e.g. 4900 = $49)
  billingInterval String                @default("month") // month, year, one_time
  isPopular       Boolean               @default(false)
  isActive        Boolean               @default(true)
  entitlements    FeatureEntitlement[]
  subscriptions   Subscription[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("plans")
}

model FeatureEntitlement {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  limit      Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("feature_entitlements")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique @map("user_id")
  planId                 String?            @map("plan_id")
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String             @default("stripe") // stripe, razorpay, mock
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  stripeCustomerId       String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?            @unique @map("stripe_subscription_id")
  stripePriceId          String?            @map("stripe_price_id")
  maxPortfolios          Int                @default(1) @map("max_portfolios")
  customDomainEnabled    Boolean            @default(false) @map("custom_domain_enabled")
  aiGenerationQuota      Int                @default(5) @map("ai_generation_quota")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments               Payment[]
  invoices               Invoice[]

  @@index([userId])
  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  subscriptionId    String?       @map("subscription_id")
  provider          String        // stripe, razorpay, mock
  providerPaymentId String?       @unique @map("provider_payment_id")
  providerOrderId   String?       @map("provider_order_id")
  amount            Int           // Smallest unit (e.g. 50000 paise / 4900 cents)
  currency          String        // INR, USD
  status            String        @default("created") // created, pending, paid, failed, refunded, cancelled, expired
  receiptUrl        String?       @map("receipt_url")
  errorMessage      String?       @map("error_message")
  refundedAmount    Int           @default(0) @map("refunded_amount")
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String    // stripe, razorpay, mock
  eventId     String    @unique @map("event_id") // Idempotency key
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now())

  @@index([provider, eventId])
  @@map("payment_events")
}

model Invoice {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  subscriptionId   String?       @map("subscription_id")
  paymentId        String?       @map("payment_id")
  invoiceNumber    String        @unique @map("invoice_number")
  amount           Int
  currency         String
  status           String        @default("paid") // paid, open, void
  hostedInvoiceUrl String?       @map("hosted_invoice_url")
  pdfUrl           String?       @map("pdf_url")
  periodStart      DateTime      @map("period_start")
  periodEnd        DateTime      @map("period_end")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now())

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ----------------------------------------------------
// 6. PROFESSIONAL PROFILE INTEGRATIONS DOMAIN (TASK 08)
// ----------------------------------------------------

enum IntegrationProvider {
  GITHUB
  LINKEDIN
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  LIMITED_PERMISSIONS
  ERROR
}

model Integration {
  id                    String              @id @default(cuid())
  userId                String              @map("user_id")
  provider              IntegrationProvider
  status                IntegrationStatus   @default(CONNECTED)
  externalAccountId     String              @map("external_account_id")
  externalUsername      String?             @map("external_username")
  scopes                String[]            @default([])
  encryptedAccessToken  String              @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?             @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt        DateTime?           @map("token_expires_at")
  lastSyncedAt          DateTime?           @map("last_synced_at")
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("integrations")
}

// ----------------------------------------------------
// 7. ANALYTICS & VISITOR TELEMETRY DOMAIN (TASK 11)
// ----------------------------------------------------

model AnalyticsEvent {
  id             String    @id @default(cuid())
  portfolioId    String    @map("portfolio_id")
  event          String    // page_view, project_view, contact_click, resume_download, github_click, linkedin_click, cta_click
  path           String    @default("/")
  deviceCategory String    @default("desktop") @map("device_category") // desktop, mobile, tablet
  referrer       String?
  countryRegion  String?   @map("country_region") // e.g. "US", "IN", "EU"
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@index([portfolioId, event])
  @@map("analytics_events")
}

model PortfolioVisit {
  id             String    @id @default(cuid())
  portfolioId    String    @map("portfolio_id")
  visitorHash    String    @map("visitor_hash") // Privacy-safe daily salted hash (NOT raw IP)
  deviceCategory String    @default("desktop") @map("device_category")
  countryRegion  String?   @map("country_region")
  referrer       String?
  path           String    @default("/")
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActiveAt   DateTime  @default(now()) @map("last_active_at")
  durationSeconds Int      @default(0) @map("duration_seconds")

  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, startedAt])
  @@index([visitorHash])
  @@map("portfolio_visits")
}

// ----------------------------------------------------
// 8. SECURITY & AUDIT LOGGING DOMAIN (TASK 11)
// ----------------------------------------------------

model AuditLog {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id")
  actorEmail     String?   @map("actor_email")
  action         String    // AUTH_LOGIN_FAILED, ADMIN_USER_DISABLED, SUBSCRIPTION_CHANGED, DOMAIN_VERIFIED, etc.
  targetResource String?   @map("target_resource") // user, portfolio, domain, subscription
  targetId       String?   @map("target_id")
  status         String    @default("SUCCESS") // SUCCESS, FAILURE
  details        Json?     // Redacted JSON payload (no secrets)
  ipAddress      String?   @map("ip_address") // Masked IP (e.g. 192.168.xxx.xxx)
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

