{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@zylo/three-engine": ["../three-engine/src/index.ts"],
      "@zylo/three-engine/*": ["../three-engine/src/*"],
      "@zylo/templates/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
