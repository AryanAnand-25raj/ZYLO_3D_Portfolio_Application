{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@zylo/three-engine": ["./packages/three-engine/src/index.ts"],
      "@zylo/three-engine/*": ["./packages/three-engine/src/*"],
      "@zylo/ai": ["./packages/ai/src/index.ts"],
      "@zylo/ai/*": ["./packages/ai/src/*"],
      "@zylo/templates": ["./packages/templates/src/index.ts"],
      "@zylo/templates/*": ["./packages/templates/src/*"],
      "@zylo/integrations": ["./packages/integrations/src/index.ts"],
      "@zylo/integrations/*": ["./packages/integrations/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
